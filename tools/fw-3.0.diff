+// Bluetooth name: "파노체크-" (12 bytes) + the name the user picked (up to 16 bytes) or the 8-digit stick ID.
+// 28 bytes at most, so it fits the scan response (31 bytes: 2 header + 29).
+static void bleName(char* out, size_t n) { snprintf(out, n, "파노체크-%s", gBname[0] ? gBname : gDevId); }
+// Keeps whole UTF-8 letters only, at most 16 bytes; drops control characters and ';' '=' (INFO separators).
+static void cleanName(const char* in, char* out) {
+  size_t o = 0;
+  for (size_t i = 0; in[i];) {
+    const uint8_t c = (uint8_t)in[i];
+    const size_t k = c < 0x80 ? 1 : (c & 0xE0) == 0xC0 ? 2 : (c & 0xF0) == 0xE0 ? 3 : (c & 0xF8) == 0xF0 ? 4 : 0;
+    if (!k) break;                                       // not UTF-8: stop here
+    bool ok = true;
+    for (size_t j = 1; j < k; ++j) if (((uint8_t)in[i + j] & 0xC0) != 0x80) { ok = false; break; }
+    if (!ok) break;
+    const bool skip = k == 1 && (c < 0x20 || c == ';' || c == '=' || c == 0x7F);
+    if (!skip) { if (o + k > 16) break; memcpy(out + o, in + i, k); o += k; }
+    i += k;
+  }
+  while (o > 0 && out[o - 1] == ' ') --o;               // no spaces at the end
+  out[o] = 0;
+  size_t s = 0; while (out[s] == ' ') ++s;              // or at the start
+  if (s) memmove(out, out + s, o - s + 1);
+}

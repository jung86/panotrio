+// Small number readers for the text commands. sscanf / strtoul / atoi would pull more C-library code into
+// IRAM, and the Plus2 build (ESP32 + PSRAM keeps the C library in IRAM) has no room left for it.
+static bool numRead(const char*& p, long& v) {
+  while (*p == ' ' || *p == '	') ++p;
+  bool neg = false;
+  if (*p == '-' || *p == '+') neg = (*p++ == '-');
+  if (*p < '0' || *p > '9') return false;
+  unsigned long x = 0;
+  while (*p >= '0' && *p <= '9') x = x * 10 + (unsigned long)(*p++ - '0');
+  v = neg ? -(long)x : (long)x;
+  return true;
+}
+static long numAtoiL(const char* p) { long v = 0; return numRead(p, v) ? v : 0; }
+static int numAtoi(const char* p) { return (int)numAtoiL(p); }
+static int numScan(const char* p, unsigned* out, int n) {        // like sscanf "%u %u ..."
+  int k = 0; long v = 0;
+  while (k < n && numRead(p, v)) out[k++] = (unsigned)v;
+  return k;
+}
+static int numScan(const char* p, int* out, int n) {             // like sscanf "%d %d ..."
+  int k = 0; long v = 0;
+  while (k < n && numRead(p, v)) out[k++] = (int)v;
+  return k;
+}

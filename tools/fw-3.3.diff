+// Bluetooth name: S3 "파노체크-" (13 bytes), Plus2 "파노체크P2-" (15 bytes) + the name the user picked
+// (up to 16 bytes) or the 8-digit stick ID. Cut to BLE_NAME_MAX bytes on a whole UTF-8 letter, so it fits
+// the scan response (31 bytes: 2 header + 29). Trailing spaces left by the cut are dropped.
+static const size_t BLE_NAME_MAX = 29;
+static void bleName(char* out, size_t n) {
+  char t[48];
+  snprintf(t, sizeof(t), "%s%s", PANO_P2 ? "파노체크P2-" : "파노체크-", gBname[0] ? gBname : gDevId);
+  size_t len = strlen(t);
+  const size_t lim = BLE_NAME_MAX < n - 1 ? BLE_NAME_MAX : n - 1;
+  if (len > lim) { len = lim; while (len > 0 && ((uint8_t)t[len] & 0xC0) == 0x80) --len; }   // back to a letter start
+  while (len > 0 && t[len - 1] == ' ') --len;
+  memcpy(out, t, len); out[len] = 0;
+}

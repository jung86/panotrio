+static std::atomic<uint32_t> imuLate{ 0 }, imuMaxUs{ 0 };   // diagnostics (serial ID)
 static void imuTask(void*) {
+  // Never runs back to back: a late read (Bluetooth busy on core 0, bigger FIFO, longer I2C read) used to make
+  // vTaskDelayUntil return at once every time, so the idle task never ran and the task watchdog restarted the
+  // stick (Plus2: RST=6 every 10-20 s). When late, wait one tick anyway and start the period again from now.
   TickType_t last = xTaskGetTickCount();
   for (;;) {
-    vTaskDelayUntil(&last, pdMS_TO_TICKS(gImuIdle.load(std::memory_order_relaxed) ? IMU_IDLE_MS : 10));
+    const TickType_t period = pdMS_TO_TICKS(gImuIdle.load(std::memory_order_relaxed) ? IMU_IDLE_MS : 10);
+    const TickType_t now = xTaskGetTickCount();
+    if ((TickType_t)(now - last) >= period) { imuLate++; vTaskDelay(1); last = xTaskGetTickCount(); }
+    else vTaskDelayUntil(&last, period);
+    if (ota::busy()) { vTaskDelay(pdMS_TO_TICKS(50)); last = xTaskGetTickCount(); continue; }   // firmware update: leave core 0 to Bluetooth (the FIFO overruns and starts fresh after)
+    const int64_t t0 = esp_timer_get_time();
     imuService();
+    const uint32_t us = (uint32_t)(esp_timer_get_time() - t0);
+    if (us > imuMaxUs.load()) imuMaxUs.store(us);
   }
 }
 
